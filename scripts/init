#!/usr/bin/env bash

set -euo pipefail

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/common.sh"

FORCE=0

usage() {
  cat <<EOF
Usage: init [--force]

Creates $ENV_FILE from $ENV_TEMPLATE_FILE.

Behavior:
- Uses exported environment variables when present.
- Prompts for values when run interactively.
- Generates POSTGRES_PASSWORD and JWT_SECRET with openssl when not provided.

Optional environment overrides:
- PROMPT_LIB_ENV_FILE
- PROMPT_LIB_ENV_TEMPLATE
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force)
      FORCE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

ensure_parent_dir() {
  mkdir -p "$(dirname "$1")"
}

generate_secret() {
  if ! command -v openssl >/dev/null 2>&1; then
    echo "openssl is required to generate secrets. Export the variable manually or install openssl." >&2
    exit 1
  fi

  openssl rand -hex 32
}

resolve_value() {
  local variable_name="$1"
  local prompt_label="$2"
  local default_value="$3"
  local mode="${4:-default}"
  local current_value="${!variable_name:-}"

  if [[ -n "$current_value" ]]; then
    printf '%s' "$current_value"
    return 0
  fi

  if [[ -t 0 && -t 1 ]]; then
    local prompt_suffix="$default_value"
    local reply

    if [[ "$mode" == "secret" ]]; then
      prompt_suffix="press Enter to generate with openssl"
    fi

    read -r -p "$prompt_label [$prompt_suffix]: " reply
    if [[ -n "$reply" ]]; then
      printf '%s' "$reply"
      return 0
    fi
  fi

  if [[ "$mode" == "secret" ]]; then
    generate_secret
    return 0
  fi

  printf '%s' "$default_value"
}

write_env_line() {
  local file_path="$1"
  local key="$2"
  local value="$3"

  printf '%s=%q\n' "$key" "$value" >>"$file_path"
}

if [[ ! -f "$ENV_TEMPLATE_FILE" ]]; then
  echo "Missing env template: $ENV_TEMPLATE_FILE" >&2
  exit 1
fi

if [[ -f "$ENV_FILE" && "$FORCE" -ne 1 ]]; then
  echo "$ENV_FILE already exists. Re-run with --force to overwrite it." >&2
  exit 1
fi

ensure_parent_dir "$ENV_FILE"

postgres_host="$(resolve_value POSTGRES_HOST "Postgres host" "127.0.0.1")"
postgres_port="$(resolve_value POSTGRES_PORT "Postgres port" "5432")"
postgres_db="$(resolve_value POSTGRES_DB "Postgres database name" "prompt_lib")"
postgres_user="$(resolve_value POSTGRES_USER "Postgres user" "postgres")"
postgres_password="$(resolve_value POSTGRES_PASSWORD "Postgres password" "" secret)"
api_port="$(resolve_value API_PORT "API port" "4000")"
frontend_origin="$(resolve_value FRONTEND_ORIGIN "Frontend origin" "http://localhost:3000")"
api_url="$(resolve_value API_URL "Backend URL for frontend proxy" "http://localhost:${api_port}")"
jwt_secret="$(resolve_value JWT_SECRET "JWT secret" "" secret)"
database_url_default="postgres://${postgres_user}:${postgres_password}@${postgres_host}:${postgres_port}/${postgres_db}"
database_url="$(resolve_value DATABASE_URL "Database URL" "$database_url_default")"

temp_file="$(mktemp)"
trap 'rm -f "$temp_file"' EXIT

write_env_line "$temp_file" POSTGRES_HOST "$postgres_host"
write_env_line "$temp_file" POSTGRES_PORT "$postgres_port"
write_env_line "$temp_file" POSTGRES_DB "$postgres_db"
write_env_line "$temp_file" POSTGRES_USER "$postgres_user"
write_env_line "$temp_file" POSTGRES_PASSWORD "$postgres_password"
write_env_line "$temp_file" DATABASE_URL "$database_url"
write_env_line "$temp_file" JWT_SECRET "$jwt_secret"
write_env_line "$temp_file" API_PORT "$api_port"
write_env_line "$temp_file" FRONTEND_ORIGIN "$frontend_origin"
write_env_line "$temp_file" API_URL "$api_url"

mv "$temp_file" "$ENV_FILE"
trap - EXIT

cat <<EOF
Created $ENV_FILE

Secrets generated automatically unless you supplied them through the environment or interactive input.
EOF